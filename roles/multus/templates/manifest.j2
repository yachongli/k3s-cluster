---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: multus
  namespace: {{ multus_vars.kubernetes.namespace }}
  labels:
    tier: node
    app: multus
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: multus
  labels:
    tier: node
    app: multus
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/status", "pods/exec"]
    verbs: ["get", "list", "watch", "update", "create"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["k8s.cni.cncf.io"]
    resources: ["network-attachment-definitions"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: multus
  labels:
    tier: node
    app: multus
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: multus
subjects:
  - kind: ServiceAccount
    name: multus
    namespace: {{ multus_vars.kubernetes.namespace }}
---
kind: ConfigMap
apiVersion: v1
metadata:
  name: multus-cni-config
  namespace: {{ multus_vars.kubernetes.namespace }}
  labels:
    tier: node
    app: multus
data:
  cni-conf.json: |
    {
      "name": "multus-cni-network",
      "type": "multus",
      "capabilities": {
        "portMappings": true
      },
      "delegates": [
        {
          "cniVersion": "0.3.1",
          "name": "default-cni-network",
          "plugins": [
            {
              "type": "cilium",
              "enable-debug": false,
              "log-file": "/var/run/cilium/cilium-cni.log"
            }
          ]
        }
      ],
      "kubeconfig": "/etc/cni/net.d/multus.d/multus.kubeconfig"
    }
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-multus-ds
  namespace: {{ multus_vars.kubernetes.namespace }}
  labels:
    tier: node
    app: multus
    name: multus
spec:
  selector:
    matchLabels:
      name: multus
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        tier: node
        app: multus
        name: multus
    spec:
      hostNetwork: true
      tolerations:
{% for tol in multus_vars.kubernetes.tolerations %}
      - key: {{ tol.key }}
        operator: {{ tol.operator }}
        effect: {{ tol.effect }}
{% endfor %}
      serviceAccountName: multus
      containers:
      - name: kube-multus
        image: {{ multus_vars.kubernetes.image.repository }}:{{ multus_vars.kubernetes.image.tag }}
        command: ["/thin_entrypoint"]
        args:
        - "--multus-conf-file=auto"
        - "--multus-autoconfig-dir=/host/etc/cni/net.d"
        - "--cni-conf-dir=/host/etc/cni/net.d"
        resources:
          {{ multus_vars.kubernetes.resources | to_nice_yaml(indent=10) | trim | indent(10) }}
        securityContext:
          privileged: true
        terminationMessagePolicy: FallbackToLogsOnError
        volumeMounts:
        - name: cni
          mountPath: /host/etc/cni/net.d
        - name: cnibin
          mountPath: /host/opt/cni/bin
        - name: multus-cfg
          mountPath: /tmp/multus-conf
      initContainers:
        - name: install-multus-binary
          image: {{ multus_vars.kubernetes.image.repository }}:{{ multus_vars.kubernetes.image.tag }}
          command: ["/install_multus"]
          args:
            - "--type"
            - "thin"
          resources:
            {{ multus_vars.kubernetes.resources | to_nice_yaml(indent=12) | trim | indent(12) }}
          securityContext:
            privileged: true
          terminationMessagePolicy: FallbackToLogsOnError
          volumeMounts:
            - name: cnibin
              mountPath: /host/opt/cni/bin
              mountPropagation: Bidirectional
      terminationGracePeriodSeconds: 10
      volumes:
        - name: cni
          hostPath:
            path: /etc/cni/net.d
        - name: cnibin
          hostPath:
            path: /opt/cni/bin
        - name: multus-cfg
          configMap:
            name: multus-cni-config
            items:
            - key: cni-conf.json
              path: {{ multus_vars.kubernetes.cni_config_file }}
